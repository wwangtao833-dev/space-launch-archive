{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wwangtao833-dev.github.io/space-launch-archive/data/schema.json",
  "title": "人类飞行器发射行动档案记录",
  "description": "archive/years-*.json.gz 中单条详情记录的结构。空字符串和零值可能是源快照的缺失值约定。",
  "type": "object",
  "required": [
    "id", "jd", "date", "vehicle", "variant", "flightId", "flight", "mission",
    "flightCode", "platform", "siteCode", "siteName", "siteLocation", "longitude",
    "latitude", "pad", "ascentSite", "ascentPad", "perigee", "apogee",
    "apogeeEstimated", "inclination", "azimuth", "range", "rangeEstimated",
    "destination", "orbitalMass", "payloadMass", "agencyCode", "agencyName",
    "launchCode", "actionType", "result", "failCode", "serviceGroup", "category",
    "citation", "citation2", "notes", "vehicleDetails", "rich", "search"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "description": "GCAT 发射行动编号；全库唯一"},
    "jd": {"type": "string", "description": "源快照中的儒略日文本"},
    "date": {
      "type": "object",
      "required": ["year", "utc", "cn", "precision"],
      "additionalProperties": false,
      "properties": {
        "year": {"type": "integer"},
        "utc": {"type": "string", "description": "GCAT 原始 UTC 文本"},
        "iso": {"type": "string", "format": "date-time", "description": "可确定具体日期时提供"},
        "cn": {"type": "string", "description": "固定 UTC+08:00 的列表显示时间"},
        "precision": {"type": "string", "enum": ["秒", "分钟", "日期", "月份", "不详"]}
      }
    },
    "vehicle": {"type": "string"},
    "variant": {"type": "string"},
    "flightId": {"type": "string"},
    "flight": {"type": "string"},
    "mission": {"type": "string"},
    "flightCode": {"type": "string"},
    "platform": {"type": "string"},
    "siteCode": {"type": "string"},
    "siteName": {"type": "string"},
    "siteLocation": {"type": "string"},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "pad": {"type": "string"},
    "ascentSite": {"type": "string"},
    "ascentPad": {"type": "string"},
    "perigee": {"type": ["number", "null"], "description": "km；负值可表示亚轨道/深空轨迹约定"},
    "apogee": {"type": ["number", "null"], "description": "km；负值可表示亚轨道/深空轨迹约定"},
    "apogeeEstimated": {"type": "boolean"},
    "inclination": {"type": ["number", "null"]},
    "azimuth": {"type": ["number", "null"]},
    "range": {"type": ["number", "null"]},
    "rangeEstimated": {"type": "boolean"},
    "destination": {"type": "string"},
    "orbitalMass": {"type": "number", "description": "t；零值按未记录或不适用展示"},
    "payloadMass": {"type": "number", "description": "t；零值按未记录或不适用展示"},
    "agencyCode": {"type": "string"},
    "agencyName": {"type": "string"},
    "launchCode": {"type": "string"},
    "actionType": {"type": "string"},
    "result": {"type": "string"},
    "failCode": {"type": "string"},
    "serviceGroup": {"type": "string"},
    "category": {"type": "string"},
    "citation": {"type": "string"},
    "citation2": {"type": "string"},
    "notes": {"type": "string"},
    "vehicleDetails": {
      "type": "object",
      "required": ["family", "manufacturer", "stages", "length", "diameter", "launchMass", "leoCapacity", "gtoCapacity", "thrust", "class", "genericName"],
      "additionalProperties": false,
      "properties": {
        "family": {"type": "string"},
        "manufacturer": {"type": "string"},
        "stages": {"type": "array"},
        "length": {"type": ["number", "null"]},
        "diameter": {"type": "number"},
        "launchMass": {"type": ["number", "null"]},
        "leoCapacity": {"type": ["number", "null"]},
        "gtoCapacity": {"type": ["number", "null"]},
        "thrust": {"type": ["number", "null"]},
        "class": {"type": "string"},
        "genericName": {"type": "string"}
      }
    },
    "rich": {"type": ["object", "null"], "description": "可选的 Launch Library 2 扩展信息"},
    "search": {"type": "string", "description": "本地全文检索文本"}
  }
}
